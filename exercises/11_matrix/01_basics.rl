// A matrix is its own type, built from a nested array with to_m(). Its values
// are always floats, whatever went in.
//
// Make this print:
//
//   MATRIX
//   [2, 3]
//   6

m = [[1, 2, 3], [4, 5, 6]].to_m()

puts(m.type())
