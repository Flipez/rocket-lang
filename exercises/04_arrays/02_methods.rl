// sort and uniq answer with a new array, leaving the original alone -- the
// same rule as upcase. Their ! forms change it in place.
//
// Make this print:
//
//   [1, 1, 3, 2]
//   [1, 2, 3]
//   7

numbers = [1, 1, 3, 2]

puts(numbers.sort())
puts(numbers)
